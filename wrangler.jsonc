// Configuration Cloudflare Workers (site statique + formulaire de rendez-vous).
// Voir DEPLOIEMENT.md. Secrets à définir dans le tableau de bord (Settings → Variables and Secrets)
// ou avec `npx wrangler secret put` : TURNSTILE_SECRET et BREVO_API_KEY.
// En local, ils se placent dans le fichier .dev.vars (non versionné).
{
  "name": "lg-advisory",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
